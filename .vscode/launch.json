{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "KomGraf - NVIDIA",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build/komgraf",

            "args": [],

            "cwd": "${workspaceFolder}",

            "stopAtEntry": false,

            "environment": [
                {
                    "name": "__NV_PRIME_RENDER_OFFLOAD",
                    "value": "1"
                },
                {
                    "name": "__GLX_VENDOR_LIBRARY_NAME",
                    "value": "nvidia"
                }
            ],

            "externalConsole": false,

            "MIMode": "gdb",

            "preLaunchTask": "Build Komputer Grafis"
        }
    ]
}
