            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Komputer Grafis"
        },
        {
            "name": "Debug Active File",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/active-${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Active OpenGL File"
        },
        {
            "name": "Debug Active File (NVIDIA)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/active-${fileBasenameNoExtension}",
            "args": [],
